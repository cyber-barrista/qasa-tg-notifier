# Copy to .env for local `make run` (docker compose). .env is gitignored.
# In production these two are set with `fly secrets set`, not from a file.

# From @BotFather:
BOT_TOKEN=123456:ABC-your-bot-token
# Your numeric Telegram chat id (message @userinfobot to find it):
CHAT_ID=123456789
# Separate chat for Bostadsförmedlingen "Bostad snabbt" notifications.
# Optional secret: leave unset to disable that notifier. Must differ from
# CHAT_ID (each notifier stores its state in its chat's pinned message).
# BOSTAD_CHAT_ID=123456790

# Optional overrides (defaults shown):
# QASA_AREA=se/stockholm
# HOME_TYPES=apartment
# POLL_INTERVAL_HOURS=3
# MAX_NOTIFY_PER_CYCLE=40
# QASA_ENDPOINT=https://api.qasa.com/graphql
# BOSTAD_POLL_INTERVAL_MINS=10
# BOSTAD_ENDPOINT=https://bostad.stockholm.se/AllaAnnonser/
# RUST_LOG=info
