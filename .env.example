# Copy to .env for local `make run` (docker compose). .env is gitignored.
# In production these two are set with `fly secrets set`, not from a file.

# From @BotFather:
BOT_TOKEN=123456:ABC-your-bot-token
# Your numeric Telegram chat id (message @userinfobot to find it):
CHAT_ID=123456789
# Separate chat for Bostadsförmedlingen "Bostad snabbt" notifications.
# Optional secret: leave unset to disable that notifier. Must differ from
# CHAT_ID (each notifier stores its state in its chat's pinned message).
# BOSTAD_CHAT_ID=123456790
# Separate chat for Da Nang (Chợ Tốt / nhatot.com) rental notifications. The
# bot must be an admin of that chat with the "Pin messages" right.
# Optional secret: leave unset to disable that notifier. Must differ from the
# other two chat ids.
# NHATOT_CHAT_ID=123456791
# DeepL API key (optional secret): translates Chợ Tốt titles and descriptions
# to English before posting. Unset posts them in Vietnamese. Free-plan keys end
# in ":fx" and are routed to api-free.deepl.com automatically.
# DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# Optional overrides (defaults shown):
# QASA_AREA=se/stockholm
# HOME_TYPES=apartment
# POLL_INTERVAL_HOURS=3
# MAX_NOTIFY_PER_CYCLE=40
# QASA_ENDPOINT=https://api.qasa.com/graphql
# BOSTAD_POLL_INTERVAL_MINS=10
# BOSTAD_ENDPOINT=https://bostad.stockholm.se/AllaAnnonser/
# NHATOT_POLL_INTERVAL_MINS=30
# NHATOT_ENDPOINT=https://gateway.chotot.com/v1/public/ad-listing
# NHATOT_CITIES=danang        # cities the notifier polls (only danang exists today)
# NHATOT_CATEGORY=1000        # cg: 1000 all real estate (homes kept), 1010 apartments, 1020 houses
# DEEPL_ENDPOINT=https://api-free.deepl.com/v2/translate
# RUST_LOG=info
